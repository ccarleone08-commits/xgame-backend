# Runtime
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
AllowedHosts=api.xgame.game;www.xgame.game;xgame.game

# SQL Server
# For local SQL Server with integrated authentication, a typical value is:
# Server=localhost;Database=BlogAppData;Trusted_Connection=true;TrustServerCertificate=true
ConnectionStrings__DefaultConnection=Server=myapp-db,1433;Database=BlogAPP;User Id=sa;Password=tUVot5yYD-FQ-cLsnX6!joh2Dmh6tCPylkMj_GqK;Encrypt=True;TrustServerCertificate=True

# Public URLs and storage
App__PublicBaseUrl=https://api.xgame.game
App__FrontendBaseUrl=https://xgame.game
App__PaymentResultPath=/FrontEnd/ChatSystemFront/crypto-deposit.html
App__PasswordResetPath=/reset-password
App__UploadsPath=/app/uploads

# CORS: add __1, __2, and so on for additional origins
Cors__AllowedOrigins__0=https://xgame.game
Cors__AllowedOrigins__1=https://www.xgame.game
Cors__AllowedOrigins__2=https://localhost
Cors__AllowedOrigins__3=capacitor://localhost
Cors__AllowedOrigins__4=https://192.168.1.70:5173

# Startup behavior
Database__ApplyMigrationsOnStartup=false
Seed__Enabled=false
Swagger__Enabled=false
ForwardedHeaders__Enabled=true

# Authentication
JwtOptions__Issuer=https://api.xgame.game
JwtOptions__Audience=https://xgame.game
JwtOptions__SecretKey=5efbc0c643fcc905e66eca6ec5bef36536fa96bde20c8695edee66d4e55b3709624a #change this to a secure random value in production
AuthCookie__Name=AuthToken
AuthCookie__HttpOnly=false
AuthCookie__Secure=true
AuthCookie__SameSite=None
AuthCookie__Hours=24

# NOWPayments
# Set Enabled=false if cryptocurrency payments are not used.
NowPayments__Enabled=true
NowPayments__ApiKey=C6SV53N-SK843Y0-J3PJQ4Q-3QPWRQQ
NowPayments__IpnSecret=2NdSCgIw09KMIvAoqiOgrVTPxBXcQtbm
# These two values are needed when payment lookup requires a NOWPayments auth token.
NowPayments__AuthEmail=CHANGE_ME
NowPayments__AuthPassword=CHANGE_ME
NowPayments__BaseUrl=https://api.nowpayments.io/v1/
NowPayments__MinimumAmountCacheMinutes=10

# SMTP for password-reset email
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_FROM_ADDRESS=CHANGE_ME
SMTP_FROM_NAME=XGame Support
